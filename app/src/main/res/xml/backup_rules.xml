<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Backup is disabled in AndroidManifest.xml (android:allowBackup="false").
        These rules are a defensive fallback if it is ever re-enabled: only
        DataStore files are eligible, and the settings store is excluded because
        it contains the last known precise location and the Premium cache.
        Widget snapshots, streak counters and databases are intentionally not
        backup-eligible.
    -->
    <include domain="file" path="datastore/"/>
    <exclude domain="file" path="datastore/settings_prefs.preferences_pb"/>
</full-backup-content>
